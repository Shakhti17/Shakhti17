# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Or, on Google Cloud, AWS, Azure or GitHub Actions, use identity federation instead of a key:
# remove ANTHROPIC_API_KEY and set these four (from the Claude Console's identity federation setup).
# ANTHROPIC_FEDERATION_RULE_ID=
# ANTHROPIC_ORGANIZATION_ID=
# ANTHROPIC_SERVICE_ACCOUNT_ID=
# ANTHROPIC_IDENTITY_TOKEN_FILE=/path/to/the/identity/token/your/platform/provides
# The password you sign in with (at least 8 characters; use a long one).
APP_PASSWORD=
# Keeps you signed in across restarts. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Set to 1 when running behind an HTTPS reverse proxy (Render, Railway, Caddy, nginx).
TRUST_PROXY=0
# Server only: the address Caddy serves with HTTPS (docker compose --profile https).
# Without your own domain, <ip-with-dashes>.sslip.io points at your server, e.g. 179-198-193-132.sslip.io
DOMAIN=
