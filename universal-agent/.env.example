# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# The password you sign in with (at least 8 characters; use a long one).
APP_PASSWORD=
# Keeps you signed in across restarts. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Set to 1 when running behind an HTTPS reverse proxy (Render, Railway, Caddy, nginx).
TRUST_PROXY=0
